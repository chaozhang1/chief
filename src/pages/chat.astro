---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chief — local test</title>
  </head>
  <body class="bg-zinc-950 text-zinc-100 font-mono min-h-screen">
    <main class="max-w-3xl mx-auto px-6 py-8">
      <div class="space-y-6">
        <header class="flex items-center justify-between border-b border-zinc-800 pb-4">
          <div>
            <h1 class="text-xl font-bold">Chief</h1>
            <p class="text-sm text-zinc-500">v0.0 local test — context hardcoded</p>
          </div>
          <div class="flex gap-2">
            <button
              id="reset"
              class="text-sm text-zinc-500 hover:text-zinc-300 px-3 py-1 border border-zinc-800 rounded"
            >
              Reset
            </button>
            <button
              id="open-proactive"
              class="text-sm bg-zinc-100 text-zinc-900 hover:bg-zinc-200 px-3 py-1 rounded font-bold"
            >
              Let Chief open
            </button>
          </div>
        </header>

        <div id="messages" class="space-y-4 min-h-[60vh]">
          <div class="text-zinc-600 text-sm">
            Click <strong>Let Chief open</strong> to see Chief proactively address you with context awareness.
            <br />
            Or just type a message below.
          </div>
        </div>

        <form id="form" class="flex gap-2 sticky bottom-4 bg-zinc-950 pt-4 border-t border-zinc-800">
          <textarea
            id="input"
            placeholder="Type to Chief..."
            class="flex-1 bg-zinc-900 border border-zinc-800 px-4 py-3 rounded text-zinc-100 placeholder-zinc-600 focus:outline-none focus:border-zinc-600 resize-none"
            rows="2"></textarea>
          <button
            type="submit"
            id="send"
            class="bg-zinc-100 text-zinc-900 px-6 py-3 rounded font-bold hover:bg-zinc-200 disabled:opacity-50"
          >
            Send
          </button>
        </form>
      </div>
    </main>

    <script is:inline>
      const messages = [];
      const messagesEl = document.getElementById("messages");
      const form = document.getElementById("form");
      const input = document.getElementById("input");
      const send = document.getElementById("send");
      const reset = document.getElementById("reset");
      const openProactive = document.getElementById("open-proactive");

      function render() {
        if (messages.length === 0) {
          messagesEl.innerHTML = `<div class="text-zinc-600 text-sm">Click <strong>Let Chief open</strong> to see Chief proactively address you with context awareness.<br />Or just type a message below.</div>`;
          return;
        }
        messagesEl.innerHTML = messages
          .map((m) => {
            const isUser = m.role === "user";
            const labelColor = isUser ? "text-zinc-400" : "text-amber-400";
            const label = isUser ? "you" : "chief";
            return `
              <div class="space-y-1">
                <div class="text-xs font-bold uppercase tracking-wider ${labelColor}">${label}</div>
                <div class="text-zinc-100 whitespace-pre-wrap leading-relaxed">${escapeHtml(m.content)}</div>
              </div>
            `;
          })
          .join("");
        window.scrollTo({ top: document.body.scrollHeight, behavior: "smooth" });
      }

      function escapeHtml(s) {
        return s
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
      }

      async function sendMessage(content, openProactively = false) {
        if (!openProactively && !content.trim()) return;
        if (content.trim()) messages.push({ role: "user", content: content.trim() });
        render();

        send.disabled = true;
        send.textContent = "...";

        try {
          const res = await fetch("/api/chat", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ messages, openProactively }),
          });
          const data = await res.json();
          if (data.error) {
            messages.push({ role: "assistant", content: `[error] ${data.error}` });
          } else {
            messages.push({ role: "assistant", content: data.reply });
          }
        } catch (e) {
          messages.push({ role: "assistant", content: `[network error] ${e.message}` });
        } finally {
          send.disabled = false;
          send.textContent = "Send";
          render();
        }
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const content = input.value;
        input.value = "";
        sendMessage(content);
      });

      input.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          form.requestSubmit();
        }
      });

      reset.addEventListener("click", () => {
        messages.length = 0;
        render();
      });

      openProactive.addEventListener("click", () => {
        if (messages.length > 0) {
          if (!confirm("This will reset the current conversation. Continue?")) return;
          messages.length = 0;
        }
        sendMessage("", true);
      });

      render();
    </script>
  </body>
</html>
