{
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "chief",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development"
  }

  // ⚠️ Bindings below disabled until you run:
  //   bun run db:create           (returns database_id → paste below)
  //   wrangler kv namespace create CHIEF_KV   (returns id → paste below)
  //   wrangler r2 bucket create chief-voice
  //
  // Re-enable when those resources exist. For local v0.0 chat test,
  // we only need OPENAI_API_KEY in .dev.vars (no D1/KV/R2 yet).
  //
  // "d1_databases": [
  //   {
  //     "binding": "CHIEF_DB",
  //     "database_name": "chief-db",
  //     "database_id": "REPLACE_WITH_ID_AFTER_db:create",
  //     "migrations_dir": "./migrations"
  //   }
  // ],
  // "kv_namespaces": [
  //   {
  //     "binding": "CHIEF_KV",
  //     "id": "REPLACE_WITH_KV_ID"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "CHIEF_R2",
  //     "bucket_name": "chief-voice"
  //   }
  // ],
  // "triggers": {
  //   "crons": [
  //     "0 20 * * 0",
  //     "0 16 * * 3",
  //     "*/15 * * * *"
  //   ]
  // }
}
