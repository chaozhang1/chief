{
  "compatibility_date": "2026-04-12",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "chief",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "CHIEF_DB",
      "database_name": "chief-db",
      "database_id": "REPLACE_WITH_ID_AFTER_db:create",
      "migrations_dir": "./migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CHIEF_KV",
      "id": "REPLACE_WITH_KV_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CHIEF_R2",
      "bucket_name": "chief-voice"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "triggers": {
    "crons": [
      "0 20 * * 0",
      "0 16 * * 3",
      "*/15 * * * *"
    ]
  }
}
