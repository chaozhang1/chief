{
  "name": "chief",
  "type": "module",
  "version": "0.0.1",
  "description": "AI Chief of Staff for one-person companies",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "generate-types": "wrangler types",
    "db:create": "wrangler d1 create chief-db",
    "db:migrate:local": "wrangler d1 migrations apply chief-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply chief-db --remote",
    "db:studio": "wrangler d1 execute chief-db --local --command='SELECT name FROM sqlite_master WHERE type=\"table\"'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@astrojs/cloudflare": "^13.1.8",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.5",
    "tailwindcss": "^4.2.2",
    "wrangler": "^4.81.1"
  },
  "overrides": {
    "vite": "^7"
  }
}
